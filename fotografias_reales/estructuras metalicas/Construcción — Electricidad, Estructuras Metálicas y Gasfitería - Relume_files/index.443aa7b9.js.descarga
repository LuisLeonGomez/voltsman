.material-symbols-rounded,
.material-symbols-sharp {
  font-weight: normal;
  font-style: normal;
  font-size: 24px;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  font-feature-settings: 'liga';
  -webkit-font-smoothing: antialiased;
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}
.material-symbols-outlined { font-family: 'Material Symbols Outlined', sans-serif; }
.material-symbols-rounded  { font-family: 'Material Symbols Rounded', sans-serif; }
.material-symbols-sharp    { font-family: 'Material Symbols Sharp', sans-serif; }

