html {
  margin: 0;
  padding: 0;
  background-color: var(--scheme1-background, #ffffff);
  color: var(--scheme1-text, #000000);
  color-scheme: var(--scheme1-color-scheme, normal);
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
}

body {
  margin: 0;
  padding: 0;
  font-family: system-ui, -apple-system, sans-serif;
}

/* Rich-text links use the stable rt-link marker in every renderer, so keep
   their browser treatment while resetting every other authored link. */
:where(a:not(.rt-link)) {
  color: inherit;
  text-decoration: none;
}

