.rt-root {
  --rt-accent: var(--color-foreground-ai);
  /* The two frame weights, matching the canvas's own hover and selection
     boxes (HOVER_BORDER_WIDTH / SELECTION_BORDER_WIDTH) — in SCREEN px. The
     editor overwrites both inline with the layout-px equivalent for the canvas
     zoom (measureFrameWidths), so a frame keeps its designed weight at every
     zoom; these are the values at 1:1, and what a plain (unzoomed) host gets.
     The dashed container frame takes the hover weight, as the canvas's dashed
     frame does. */
  --rt-hover: 1.5px;
  --rt-selected: 1px;
  position: relative;
  font-size: 1rem;
  line-height: 1.5;
  outline: none;
}

.rt-root[data-scroll] {
  overflow-x: auto;
}

.rt-table {
  width: 100%;
}

.rt-root[data-as='table'] .rt-table {
  border-collapse: separate;
  border-spacing: 0;
  table-layout: fixed;
}

.rt-root[data-as='div'] .rt-row {
  display: grid;
  align-items: stretch;
}

/* Equal tracks, the same default the published page emits and at the same
   zero specificity, so the theme class on the table sets the real proportions
   in both. The canvas only overrides this inline while a drag needs a fixed
   placeholder track. */
:where(.rt-root[data-as='div'] .rt-row) {
  grid-template-columns: repeat(var(--rt-cols, 1), minmax(0, 1fr));
}

/* A cell's defaults, and the grid box it needs to be a cell. Wrapped in
   :where() so they carry no specificity: the design comes from the theme
   class on the table, and a rule there must win here exactly as it does in the
   published page, which has no editor stylesheet to compete with. */
:where(.rt-cell) {
  position: relative;
  min-width: 0;
  font-weight: 400;
  overflow-wrap: anywhere;
}

.rt-cell {
  user-select: none;
  cursor: default;
}

:where(.rt-root[data-as='div'] .rt-cell) {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
}

.rt-root[data-as='div'] .rt-cell[data-span] {
  grid-column: 1 / -1;
}

/* A group head lays its chevron out beside the label, so in grid mode the
   cell flows along the row rather than stacking its content. */
.rt-root[data-as='div'] .rt-cell[data-group-head] {
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
}

/* The same row inside a table-mode head: a <td> cannot be a flex box without
   losing its colspan, so its chevron and component sit in one of their own. */
.rt-groupHead {
  display: flex;
  align-items: center;
}

/* The collapse button's look, in :where() so it carries no specificity — a
   theme class reaching [data-tgroup-toggle] moves it, resizes it or restyles
   it, and gets the same result here as on the published page. */
:where(.rt-groupToggle) {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  margin-right: 0.5rem;
  padding: 0;
  border: 0;
  background: none;
  color: inherit;
}

.rt-groupToggle {
  cursor: pointer;
}

.rt-groupToggle svg {
  transition: transform 120ms ease;
}

.rt-groupToggle[data-open] svg {
  transform: rotate(180deg);
}

/* The container of a selected row: the group it sits in, dashed, the way the
   canvas dashes a list wrapper around a selected item — same 1.5px weight as
   its DashedOverlay. Drawn on the rows themselves (a group is a run of them)
   and inset so it never moves the grid. */
.rt-row {
  position: relative;
}

.rt-row[data-group-frame]::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  border: 0 dashed var(--rt-accent);
  border-left-width: var(--rt-hover);
  border-right-width: var(--rt-hover);
}

.rt-row[data-group-frame~='top']::after {
  border-top-width: var(--rt-hover);
}

.rt-row[data-group-frame~='bottom']::after {
  border-bottom-width: var(--rt-hover);
}

/* A framed column, as one box over its whole height: its cells cannot draw it,
   because a category row is a single cell spanning every column. Same weights
   as a cell's frame — the canvas's hover and selection weights. */
.rt-colFrame {
  position: absolute;
  z-index: 1;
  pointer-events: none;
  border: var(--rt-hover) solid var(--rt-accent);
}

.rt-colFrame[data-selected] {
  border-width: var(--rt-selected);
}

/* Hover, on one box: the cell under the pointer outlines itself — the
   smallest thing a click would act on — and the cells on a hovered line's
   outside draw one outline around the whole row or column, so pointing at
   a handle says exactly what it will act on. A pseudo-element rather than the
   cell's own outline property, so it paints above the neighbouring cells'
   borders; ::after is the selection's, above this one. */
.rt-cell[data-line-edge]::before,
.rt-cell[data-hovered]::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
  border: 0 solid var(--rt-accent);
}

.rt-cell[data-hovered]::before {
  border-width: var(--rt-hover);
}

.rt-cell[data-line-edge~='top']::before {
  border-top-width: var(--rt-hover);
}

.rt-cell[data-line-edge~='bottom']::before {
  border-bottom-width: var(--rt-hover);
}

.rt-cell[data-line-edge~='left']::before {
  border-left-width: var(--rt-hover);
}

.rt-cell[data-line-edge~='right']::before {
  border-right-width: var(--rt-hover);
}

/* Selection: the cells on the range's outer edge draw its outline, so it
   tracks any relayout. No fill — the design carries selection on the outline
   alone, cell and whole line alike, at the canvas's selection weight. */
.rt-cell[data-selected]::after,
.rt-cell[data-editing]::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;
}

.rt-cell[data-editing]::after {
  background: transparent;
  box-shadow: inset 0 0 0 2px var(--rt-accent);
}

.rt-cell[data-sel-edge]::after {
  border: 0 solid var(--rt-accent);
}

.rt-cell[data-sel-edge~='top']::after {
  border-top-width: var(--rt-selected);
}

.rt-cell[data-sel-edge~='bottom']::after {
  border-bottom-width: var(--rt-selected);
}

.rt-cell[data-sel-edge~='left']::after {
  border-left-width: var(--rt-selected);
}

.rt-cell[data-sel-edge~='right']::after {
  border-right-width: var(--rt-selected);
}

/* Text fields */
.rt-field {
  display: inline-block;
  min-width: 1ch;
  max-width: 100%;
  white-space: pre-wrap;
  text-decoration: inherit;
  outline: none;
}

.rt-field:empty::before {
  content: '\\200b';
}

.rt-field[contenteditable] {
  position: relative;
  z-index: 2;
  user-select: text;
  cursor: text;
}

/* Component cells */
/* An embedded frame the host canvas owns: interactive, fills the cell. */
.rt-embed {
  display: flex;
  flex-direction: column;
  flex: 1;
  width: 100%;
  overflow-wrap: normal;
}

/* Display-only inside the cell: clicks must land on the cell so the host
   canvas selects the table node, not an element inside the component. Words
   inside a component wrap like anywhere else on the page, not mid-word. The
   component fills the cell, so a card can pin its button to the bottom. */
.rt-component {
  display: flex;
  flex-direction: column;
  flex: 1;
  width: 100%;
  pointer-events: none;
  overflow-wrap: normal;
}

.rt-componentPlaceholder {
  display: inline-block;
  padding: 0.25rem 0.5rem;
  border: 1px dashed #94a3b8;
  border-radius: 4px;
  color: #64748b;
  font-size: 0.75rem;
}

/* Reordering: the dragged line leaves the flow and this box holds its slot at
   the hovered gap, square like the frame round the line in hand. A row's sits
   in a bare row of its own (a block sibling of the rows in grid mode); a
   column's is one box over the bare slot every row holds open. */
.rt-dropPlaceholder {
  /* Above the table's own borders, which would otherwise draw across it. */
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  /* The grey over the section's fill (set while a drag runs), so nothing
     painted under the slot shows through; with no fill found, the grey alone. */
  background:
    linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.1)),
    var(--rt-drop-backdrop, transparent);
  border: 1px solid
    color-mix(in oklab, var(--color-border-primary) 15%, transparent);
  pointer-events: none;
}

/* A column drag's: the table's full height, measured off the slots. */
.rt-dropPlaceholder[data-column] {
  position: absolute;
}
